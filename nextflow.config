docker {
    enabled = false
    runOptions = '--user 0:0'
}

profiles {
    docker {
        docker.enabled = true
    }
    test {
        docker.enabled = true
        process.cpus = 2
        process.memory = '3 GB'
        params.outdir = 'tests/output'
        params.reference_name = 'synthetic_test_reference'
        params.annotation_name = 'synthetic_fixture_annotation'
        params.reference_scope = 'synthetic_execution_only'
        params.star_sjdb_overhang = 49
        params.star_sa_index_nbases = 3
        params.star_chr_bin_nbits = 10
        params.atac_effective_genome_size = 100000
        params.chip_effective_genome_size = 100000
        params.dmrseq_max_perms = 2
    }
}

timeline.enabled = true
timeline.file = "${params.outdir}/${params.assay.toLowerCase()}/provenance/execution_timeline.html"
trace.enabled = true
trace.file = "${params.outdir}/${params.assay.toLowerCase()}/provenance/execution_trace.tsv"
trace.overwrite = true
report.enabled = true
report.file = "${params.outdir}/${params.assay.toLowerCase()}/provenance/execution_report.html"
report.overwrite = true
dag.enabled = true
dag.file = "${params.outdir}/${params.assay.toLowerCase()}/provenance/workflow_dag.html"
dag.overwrite = true
timeline.overwrite = true

